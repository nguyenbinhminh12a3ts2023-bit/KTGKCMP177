@{
    ViewBag.Title = "Nhập đề từ Word";
    Layout = "~/Views/Shared/Layout/_Layout.cshtml";
}

<style>
    :root {
        --primary: #087F82;
        --primary-light: #E7F4F3;
        --navy: #18324F;
        --navy-dark: #23364B;
        --muted: #68788A;
        --bg: #F4F7FA;
        --card-bg: #FFFFFF;
        --border: #DCE4EC;
    }
    .toeic-container {
        padding: 24px 32px;
        background-color: var(--bg);
        min-height: calc(100vh - 120px);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .toeic-breadcrumb {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 8px;
    }
    .toeic-title {
        font-size: 26px;
        font-weight: 800;
        color: var(--navy);
        margin: 0 0 6px 0;
    }
    .toeic-subtitle {
        font-size: 14px;
        color: var(--muted);
        margin-bottom: 24px;
    }
    .upload-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 36px;
        max-width: 800px;
        margin: 0 auto;
    }
    .dropzone-box {
        border: 2px dashed var(--primary);
        background-color: var(--primary-light);
        border-radius: 12px;
        padding: 48px 24px;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
    }
    .dropzone-box:hover {
        background-color: #d8efed;
    }
    .dropzone-icon {
        width: 56px;
        height: 56px;
        color: var(--primary);
        margin-bottom: 16px;
    }
    .instructions-card {
        background-color: #F8FAFC;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        margin-top: 24px;
    }
    .instructions-card h4 {
        margin: 0 0 10px 0;
        font-size: 14px;
        font-weight: 700;
        color: var(--navy);
    }
    .tag-pill {
        display: inline-block;
        background: #FFFFFF;
        border: 1px solid var(--border);
        padding: 2px 8px;
        border-radius: 4px;
        font-family: monospace;
        font-size: 12px;
        color: var(--primary);
        font-weight: 600;
        margin: 2px;
    }
</style>

<div class="toeic-container">
    <div class="toeic-breadcrumb">Đề thi Reading / <a href="@Url.Action("Index", "ToeicAdmin")" style="color: var(--muted);">Quản lý đề thi</a> / Nhập đề từ Word</div>
    
    <div style="max-width: 800px; margin: 0 auto;">
        <h1 class="toeic-title">Nhập đề từ Word</h1>
        <div class="toeic-subtitle">Tải lên tệp đề thi (.docx) định dạng chuẩn ETS. Hệ thống sẽ tự động quét, kiểm tra tính hợp lệ và bóc tách câu hỏi.</div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div style="background-color: #FEE2E2; border: 1px solid #FCA5A5; color: #DC2626; padding: 14px 18px; border-radius: 10px; margin-bottom: 20px;">
                <strong>Lỗi:</strong> @ViewBag.ErrorMessage
            </div>
        }

        <div class="upload-card">
            <form action="@Url.Action("Upload", "ToeicAdmin")" method="post" enctype="multipart/form-data" id="uploadForm">
                @Html.AntiForgeryToken()
                
                <div class="dropzone-box" onclick="document.getElementById('fileInput').click()">
                    <svg class="dropzone-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                    <div style="font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 6px;">
                        Kéo thả file .docx vào đây, hoặc <span style="color: var(--primary); text-decoration: underline;">chọn tệp</span>
                    </div>
                    <div style="font-size: 13px; color: var(--muted);" id="fileNameDisplay">
                        Hỗ trợ định dạng Microsoft Word (.docx). Dung lượng tối đa: 25MB.
                    </div>
                    <input type="file" id="fileInput" name="wordFile" accept=".docx" style="display: none;" onchange="handleFileSelect(this)">
                </div>

                <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 12px;">
                    <a href="@Url.Action("Index", "ToeicAdmin")" style="padding: 10px 20px; border-radius: 8px; border: 1px solid var(--border); color: var(--muted); text-decoration: none; font-weight: 600;">Hủy bỏ</a>
                    <button type="submit" id="submitBtn" disabled style="padding: 10px 24px; border-radius: 8px; border: none; background-color: var(--primary); color: #fff; font-weight: 700; cursor: not-allowed; opacity: 0.6;">
                        Tiến hành kiểm tra đề
                    </button>
                </div>
            </form>

            <div class="instructions-card">
                <h4>Quy ước cấu trúc tags trong file Word (.docx):</h4>
                <div style="font-size: 13px; color: var(--navy-dark); line-height: 1.6;">
                    • <span class="tag-pill">[TEST] Tên bài thi</span>: Bắt đầu khai báo bài thi.<br>
                    • <span class="tag-pill">[PART: 5|6|7]</span>: Khai báo từng phần thi.<br>
                    • <span class="tag-pill">[GROUP: 131-134]</span>: Khai báo nhóm câu hỏi đoạn văn.<br>
                    • <span class="tag-pill">[PASSAGE]</span>: Nội dung bài đọc / đoạn văn.<br>
                    • <span class="tag-pill">[QUESTION: 101]</span> và <span class="tag-pill">[A]..[D]</span>: Câu hỏi và 4 đáp án.<br>
                    • <span class="tag-pill">[ANSWER: 101] B</span>: Đáp án đúng chính thức.<br>
                    <em style="color: #DC2626; margin-top: 6px; display: block;">* Chú ý: Hệ thống áp dụng quy tắc từ chối toàn bộ nếu phát hiện bất kỳ lỗi tag nào.</em>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function handleFileSelect(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            document.getElementById('fileNameDisplay').innerHTML = '<strong>Đã chọn:</strong> ' + file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
            var btn = document.getElementById('submitBtn');
            btn.disabled = false;
            btn.style.cursor = 'pointer';
            btn.style.opacity = '1';
        }
    }
</script>
