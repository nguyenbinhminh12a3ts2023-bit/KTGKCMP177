@model aspnetboilerplate.com.Toeic.Dto.ToeicExamDto
@{
    ViewBag.Title = "Xem trước đề thi";
    Layout = "~/Views/Shared/Layout/_Layout.cshtml";
}

<style>
    :root {
        --primary: #087F82;
        --primary-light: #E7F4F3;
        --navy: #18324F;
        --navy-dark: #23364B;
        --muted: #68788A;
        --bg: #F4F7FA;
        --card-bg: #FFFFFF;
        --border: #DCE4EC;
    }
    .toeic-container {
        padding: 24px 32px;
        background-color: var(--bg);
        min-height: calc(100vh - 120px);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .toeic-breadcrumb {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 8px;
    }
    .toeic-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
    .preview-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
    }
    .passage-box {
        background-color: #F8FAFC;
        border-left: 4px solid var(--primary);
        padding: 16px 20px;
        border-radius: 4px;
        margin-bottom: 20px;
        line-height: 1.6;
        font-size: 14px;
        white-space: pre-line;
    }
    .question-item {
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
    }
    .question-item:last-child {
        border-bottom: none;
    }
    .question-stem {
        font-weight: 600;
        color: var(--navy);
        font-size: 14.5px;
        margin-bottom: 12px;
    }
    .options-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 16px;
    }
    .option-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
    }
    .option-label {
        font-weight: 700;
        color: var(--muted);
        width: 20px;
    }
    .option-row.correct-ans .option-label {
        color: var(--primary);
    }
    .option-row.correct-ans .option-text {
        color: var(--primary);
        font-weight: 700;
    }
    .correct-badge {
        background-color: var(--primary-light);
        color: var(--primary);
        font-size: 11px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        margin-left: 6px;
    }
</style>

<div class="toeic-container">
    <div class="toeic-breadcrumb">
        Đề thi Reading / <a href="@Url.Action("Index", "ToeicAdmin")" style="color: var(--muted);">Quản lý đề thi</a> / Xem trước đề thi
    </div>

    <div class="toeic-header">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: var(--navy); margin: 0 0 4px 0;">Xem trước đề thi</h1>
            <div style="font-size: 13.5px; color: var(--muted);">@Model.Title · 100 câu hỏi · 75 phút</div>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="@Url.Action("Edit", "ToeicAdmin", new { id = Model.Id })" style="padding: 9px 16px; background-color: var(--primary-light); color: var(--primary); border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 13.5px;">Chỉnh sửa</a>
            <a href="@Url.Action("Index", "ToeicAdmin")" style="padding: 9px 16px; background-color: #EDF2F7; color: var(--navy); border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 13.5px;">Quay lại</a>
        </div>
    </div>

    @foreach (var part in Model.Parts.OrderBy(p => p.PartNumber))
    {
        <div style="margin-top: 32px; margin-bottom: 16px;">
            <h2 style="font-size: 18px; font-weight: 800; color: var(--navy); margin: 0 0 4px 0;">@part.Title</h2>
            <div style="font-size: 13px; color: var(--muted);">@part.Description (@(part.QuestionCount) câu hỏi)</div>
        </div>

        @if (part.PartNumber == 5)
        {
            <div class="preview-card">
                @foreach (var q in part.Questions.OrderBy(x => x.QuestionNumber))
                {
                    <div class="question-item">
                        <div class="question-stem">
                            <strong>Câu @q.QuestionNumber:</strong> @q.QuestionText
                        </div>
                        <div class="options-grid">
                            @foreach (var opt in q.Options.OrderBy(o => o.Label))
                            {
                                var isCorrect = opt.IsCorrect || opt.Label == q.CorrectAnswer;
                                <div class="option-row @(isCorrect ? "correct-ans" : "")">
                                    <span class="option-label">(@opt.Label)</span>
                                    <span class="option-text">@opt.Text</span>
                                    @if (isCorrect)
                                    {
                                        <span class="correct-badge">Đáp án đúng</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @foreach (var grp in part.Groups.OrderBy(g => g.Id))
            {
                <div class="preview-card">
                    <div style="font-size: 13px; font-weight: 700; color: var(--primary); margin-bottom: 8px;">
                        Câu hỏi @grp.GroupRange @(string.IsNullOrEmpty(grp.Title) ? "" : "· " + grp.Title)
                    </div>
                    @if (!string.IsNullOrEmpty(grp.PassageText))
                    {
                        <div class="passage-box">@grp.PassageText</div>
                    }
                    @foreach (var q in grp.Questions.OrderBy(x => x.QuestionNumber))
                    {
                        <div class="question-item">
                            <div class="question-stem">
                                <strong>Câu @q.QuestionNumber:</strong>
                                @if (q.BlankNumber.HasValue)
                                {
                                    <span>Vị trí trống [@q.BlankNumber] trong đoạn văn</span>
                                }
                                else
                                {
                                    <span>@q.QuestionText</span>
                                }
                            </div>
                            <div class="options-grid">
                                @foreach (var opt in q.Options.OrderBy(o => o.Label))
                                {
                                    var isCorrect = opt.IsCorrect || opt.Label == q.CorrectAnswer;
                                    <div class="option-row @(isCorrect ? "correct-ans" : "")">
                                        <span class="option-label">(@opt.Label)</span>
                                        <span class="option-text">@opt.Text</span>
                                        @if (isCorrect)
                                        {
                                            <span class="correct-badge">Đáp án đúng</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>
