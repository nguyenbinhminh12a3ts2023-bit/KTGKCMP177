@model List<aspnetboilerplate.com.Toeic.Dto.ToeicExamDto>
@{
    ViewBag.Title = "Quản lý đề thi";
    Layout = "~/Views/Shared/Layout/_Layout.cshtml";
}

<style>
    :root {
        --primary: #087F82;
        --primary-light: #E7F4F3;
        --navy: #18324F;
        --navy-dark: #23364B;
        --muted: #68788A;
        --bg: #F4F7FA;
        --card-bg: #FFFFFF;
        --border: #DCE4EC;
    }
    .toeic-container {
        padding: 24px 32px;
        background-color: var(--bg);
        min-height: calc(100vh - 120px);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .toeic-breadcrumb {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 8px;
    }
    .toeic-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }
    .toeic-title {
        font-size: 26px;
        font-weight: 800;
        color: var(--navy);
        margin: 0 0 6px 0;
    }
    .toeic-subtitle {
        font-size: 14px;
        color: var(--muted);
    }
    .btn-toeic-primary {
        background-color: var(--primary);
        color: #FFFFFF !important;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 2px 4px rgba(8, 127, 130, 0.2);
        transition: 0.2s;
    }
    .btn-toeic-primary:hover {
        background-color: #066567;
        color: #FFFFFF !important;
    }
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }
    .stat-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px 24px;
    }
    .stat-label {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 8px;
        font-weight: 500;
    }
    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: var(--navy);
    }
    .exams-table-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }
    .table-toolbar {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .toeic-table {
        width: 100%;
        border-collapse: collapse;
    }
    .toeic-table th {
        background-color: #FAFBFD;
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 14px 20px;
        text-align: left;
        border-bottom: 1px solid var(--border);
    }
    .toeic-table td {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        color: var(--navy-dark);
        font-size: 14px;
        vertical-align: middle;
    }
    .exam-title-cell {
        font-weight: 600;
        color: var(--navy);
    }
    .exam-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background-color: var(--primary-light);
        color: var(--primary);
    }
    .action-links {
        display: flex;
        gap: 12px;
    }
    .action-btn {
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 6px;
        transition: 0.15s;
    }
    .action-btn-preview {
        color: var(--primary);
        background-color: var(--primary-light);
    }
    .action-btn-preview:hover {
        background-color: #d1ebe8;
        color: var(--primary);
    }
    .action-btn-edit {
        color: var(--navy);
        background-color: #EDF2F7;
    }
    .action-btn-edit:hover {
        background-color: #e2e8f0;
        color: var(--navy);
    }
</style>

<div class="toeic-container">
    <div class="toeic-breadcrumb">Đề thi Reading / Quản lý đề thi</div>
    
    <div class="toeic-header">
        <div>
            <h1 class="toeic-title">Quản lý đề thi</h1>
            <div class="toeic-subtitle">Quản lý danh sách các đề TOEIC Reading, nhập đề chuẩn từ file Word và chỉnh sửa nội dung.</div>
        </div>
        <a href="@Url.Action("Import", "ToeicAdmin")" class="btn-toeic-primary">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
            Nhập đề từ Word
        </a>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-label">Tổng số đề thi</div>
            <div class="stat-value">@(Model?.Count ?? 0) đề</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Thời gian thi chuẩn</div>
            <div class="stat-value">75 phút</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Số câu hỏi mỗi đề</div>
            <div class="stat-value">100 câu (101–200)</div>
        </div>
    </div>

    <div class="exams-table-card">
        <div class="table-toolbar">
            <span style="font-weight: 700; color: var(--navy); font-size: 16px;">Danh sách đề thi hiện có</span>
            <span style="font-size: 13px; color: var(--muted);">Cập nhật mới nhất</span>
        </div>
        <table class="toeic-table">
            <thead>
                <tr>
                    <th>Tên đề thi</th>
                    <th>Thời gian</th>
                    <th>Số câu hỏi</th>
                    <th>Cấu trúc</th>
                    <th>Ngày tạo</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var exam in Model)
                    {
                        <tr>
                            <td>
                                <div class="exam-title-cell">@exam.Title</div>
                                <div style="font-size: 12px; color: var(--muted);">@exam.Description</div>
                            </td>
                            <td>@exam.DurationMinutes phút</td>
                            <td><span class="exam-badge">@exam.TotalQuestions câu</span></td>
                            <td style="font-size: 13px; color: var(--muted);">Part 5 (30c) · Part 6 (16c) · Part 7 (54c)</td>
                            <td style="font-size: 13px; color: var(--muted);">@exam.CreationTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="text-align: right;">
                                <div class="action-links" style="justify-content: flex-end;">
                                    <a href="@Url.Action("Preview", "ToeicAdmin", new { id = exam.Id })" class="action-btn action-btn-preview">Xem trước</a>
                                    <a href="@Url.Action("Edit", "ToeicAdmin", new { id = exam.Id })" class="action-btn action-btn-edit">Chỉnh sửa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 48px; color: var(--muted);">
                            Chưa có đề thi nào trong cơ sở dữ liệu. Nhấn "Nhập đề từ Word" để bắt đầu tải lên file đề thi.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
